vendor/*
composer.lock
.DS_Store

# Brightree's WSDLs are their proprietary material and are never committed.
# Keep a local copy to run the contract tests or tools/generate-types.php;
# point BRIGHTREE_WSDL_DIR at it if you keep it outside the project.
Brightree Services/
*.wsdl

# The one exception: a generic contract written for the test suite. It is not
# Brightree material and the two-tier suite needs it available everywhere.
!tests/Fixtures/*.wsdl
